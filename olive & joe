function CountdownTimer({ compact }) {
  const [left, setLeft] = React.useState(() => {
    const end = new Date();
    end.setHours(23, 59, 59, 999);
    return Math.max(0, end - new Date());
  });
  React.useEffect(() => {
    const t = setInterval(() => {
      const end = new Date();
      end.setHours(23, 59, 59, 999);
      setLeft(Math.max(0, end - new Date()));
    }, 1000);
    return () => clearInterval(t);
  }, []);
  const h = String(Math.floor(left / 3600000)).padStart(2, "0");
  const m = String(Math.floor((left % 3600000) / 60000)).padStart(2, "0");
  const s = String(Math.floor((left % 60000) / 1000)).padStart(2, "0");
  return (
    <div style={{ display: "flex", alignItems: "center", gap: 5 }}>
      {!compact && <span style={{ fontFamily: "'Manrope', sans-serif", fontSize: 10, color: COLORS.goldSoft, marginRight: 2 }}>Ends in</span>}
      {[h, m, s].map((v, i) => (
        <React.Fragment key={i}>
          {i > 0 && <span style={{ color: COLORS.gold, fontSize: 11, fontWeight: 700 }}>:</span>}
          <span style={{
            background: COLORS.black, color: COLORS.gold, fontFamily: "'Manrope', sans-serif", fontWeight: 800,
            fontSize: 11, padding: "2px 5px", borderRadius: 2, border: `1px solid rgba(185,151,91,0.4)`,
          }}>{v}</span>
        </React.Fragment>
      ))}
    </div>
  );
}

